const D=window.R2_DATA, R=D.retailers, P=D.products, S=D.scans; let donut,bar;
const n=x=>Number(x)||0, f=x=>n(x).toLocaleString('id-ID'), pct=x=>(n(x)*100).toFixed(1)+'%';
const q3=r=>S.filter(s=>String(s.Retailer_ID)==String(r.Retailer_ID)).reduce((a,s)=>a+n(s.Point),0);
const ytd=r=>n(r.Q1_Point)+n(r.Q2_Point)+q3(r);
const calc=()=>{let rs=R.filter(r=>!document.getElementById('salesFilter').value||r.Sales==document.getElementById('salesFilter').value).filter(r=>!document.getElementById('areaFilter').value||r.Area==document.getElementById('areaFilter').value);let qt=rs.reduce((a,r)=>a+n(r.Q3_Target),0),qa=rs.reduce((a,r)=>a+q3(r),0),at=rs.reduce((a,r)=>a+n(r.Annual_Target_2026),0),yt=rs.reduce((a,r)=>a+ytd(r),0);return{rs,qt,qa,at,yt}};
function render(){let x=calc(),qa=x.qa,qt=x.qt,yt=x.yt,at=x.at;document.getElementById('q3target').textContent=f(qt);document.getElementById('q3actual').textContent=f(qa);document.getElementById('q3ach').textContent=qt?pct(qa/qt):'0%';document.getElementById('annual').textContent=f(at);document.getElementById('ytd').textContent=f(yt);document.getElementById('ytdach').textContent=at?pct(yt/at):'0%';document.getElementById('donutText').textContent=qt?pct(qa/qt):'0%';
if(donut)donut.destroy();donut=new Chart(document.getElementById('donut'),{type:'doughnut',data:{labels:['Actual','Gap'],datasets:[{data:[Math.min(qa,qt),Math.max(qt-qa,0)]}]},options:{cutout:'75%',plugins:{legend:{position:'bottom'}}}});
let qs=[x.rs.reduce((a,r)=>a+n(r.Q1_Point),0),x.rs.reduce((a,r)=>a+n(r.Q2_Point),0),qa];if(bar)bar.destroy();bar=new Chart(document.getElementById('quarter'),{type:'bar',data:{labels:['Q1','Q2','Q3'],datasets:[{label:'Point',data:qs}]},options:{plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}}});
let rank=x.rs.map(r=>({name:r.Retailer_Name,p:q3(r)})).sort((a,b)=>b.p-a.p).slice(0,8);document.getElementById('rank').innerHTML=rank.map((a,i)=>`<div class="rankrow"><span>#${i+1}</span><b>${a.name}</b><b>${f(a.p)}</b></div>`).join('');
let ar=x.rs.map(r=>({name:r.Retailer_Name,p:n(r.Q3_Target)?q3(r)/n(r.Q3_Target):0})).sort((a,b)=>b.p-a.p).slice(0,8);document.getElementById('achrank').innerHTML=ar.map((a,i)=>`<div class="rankrow"><span>#${i+1}</span><b>${a.name}</b><b>${pct(a.p)}</b></div>`).join('');
document.getElementById('table').innerHTML=x.rs.slice().sort((a,b)=>q3(b)-q3(a)).map(r=>`<tr><td>${r.Retailer_Name}</td><td>${f(r.Q3_Target)}</td><td>${f(q3(r))}</td><td>${pct(n(r.Q3_Target)?q3(r)/n(r.Q3_Target):0)}</td><td>${f(r.Annual_Target_2026)}</td><td>${f(ytd(r))}</td><td>${pct(n(r.Annual_Target_2026)?ytd(r)/n(r.Annual_Target_2026):0)}</td></tr>`).join('')}
function inputInit(){let rs=document.getElementById('rsel'),ps=document.getElementById('psel');rs.innerHTML=R.filter(r=>String(r.Active).toUpperCase()=='YES').map(r=>`<option value="${r.Retailer_ID}">${r.Retailer_Name}</option>`).join('');ps.innerHTML=P.filter(p=>String(p.Active).toUpperCase()=='YES').map(p=>`<option value="${p.Product_ID}">${p.Product_Name} — ${p.Pack_Size||''}</option>`).join('');updateInput()}
function updateInput(){let p=P.find(x=>String(x.Product_ID)==String(document.getElementById('psel').value))||{},q=n(document.getElementById('qty').value);document.getElementById('pp').textContent=f(p.Point_Per_Box);document.getElementById('vv').textContent=f(p.Volume_Per_Box)+' '+(p.Volume_Unit||'');document.getElementById('val').textContent=f(p.Value_Per_Box);document.getElementById('tp').textContent=f(q*n(p.Point_Per_Box));document.getElementById('tv').textContent=f(q*n(p.Volume_Per_Box));document.getElementById('tx').textContent=f(q*n(p.Value_Per_Box))}
function saveLocal(){let rid=document.getElementById('rsel').value,pid=document.getElementById('psel').value,q=n(document.getElementById('qty').value),p=P.find(x=>String(x.Product_ID)==String(pid));if(!rid||!p||q<=0)return;S.push({Retailer_ID:rid,Product_ID:pid,Qty_Box:q,Point:q*n(p.Point_Per_Box),Volume:q*n(p.Volume_Per_Box),Value:q*n(p.Value_Per_Box)});document.getElementById('status').textContent='✓ Tersimpan di mode demo. Hubungkan Apps Script untuk penyimpanan permanen.';render()}
document.querySelectorAll('.nav').forEach(b=>b.onclick=()=>{document.querySelectorAll('.nav').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById(b.dataset.page).classList.add('active');if(b.dataset.page==='dashboard')render()});
document.getElementById('salesFilter').onchange=render;document.getElementById('areaFilter').onchange=render;document.getElementById('psel').onchange=updateInput;document.getElementById('qty').oninput=updateInput;document.getElementById('save').onclick=saveLocal;
let sales=[...new Set(R.map(r=>r.Sales).filter(Boolean))],areas=[...new Set(R.map(r=>r.Area).filter(Boolean))];sales.forEach(v=>document.getElementById('salesFilter').insertAdjacentHTML('beforeend',`<option>${v}</option>`));areas.forEach(v=>document.getElementById('areaFilter').insertAdjacentHTML('beforeend',`<option>${v}</option>`));inputInit();render();